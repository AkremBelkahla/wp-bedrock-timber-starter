<section class="contact-form">
    {% if contact_form.status == 'success' %}
        <p class="contact-form__feedback is-success" data-contact-form-feedback>
            {{ __('Merci, votre message a bien été envoyé.', 'studio-atlas') }}
        </p>
    {% elseif contact_form.status == 'error' %}
        <p class="contact-form__feedback is-error" data-contact-form-feedback>
            {{ __('Une erreur est survenue, merci de réessayer.', 'studio-atlas') }}
        </p>
    {% else %}
        <p class="contact-form__feedback" data-contact-form-feedback></p>
    {% endif %}

    <form class="contact-form__form" method="post" action="{{ contact_form_action }}" data-contact-form novalidate>
        {{ contact_form.nonce_field|raw }}
        <input type="hidden" name="{{ contact_form.field_marker }}" value="1">

        {# Honeypot anti-spam : champ masqué visuellement (voir styles), jamais rempli par un humain #}
        <div class="contact-form__honeypot" aria-hidden="true">
            <label for="website">{{ __('Site web', 'studio-atlas') }}</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
        </div>

        <div class="contact-form__field">
            <label for="contact-name">{{ __('Nom', 'studio-atlas') }}</label>
            <input type="text" id="contact-name" name="name" required>
        </div>

        <div class="contact-form__field">
            <label for="contact-email">{{ __('Email', 'studio-atlas') }}</label>
            <input type="email" id="contact-email" name="email" required>
        </div>

        <div class="contact-form__field">
            <label for="contact-message">{{ __('Message', 'studio-atlas') }}</label>
            <textarea id="contact-message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="button">{{ __('Envoyer', 'studio-atlas') }}</button>
    </form>
</section>
