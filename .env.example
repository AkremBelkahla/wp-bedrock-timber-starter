# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
DB_NAME=db
DB_USER=db
DB_PASSWORD=db
DB_HOST=db

# -----------------------------------------------------------------------------
# Environnement Bedrock : development | staging | production
# Détermine le fichier chargé dans config/environments/
# -----------------------------------------------------------------------------
WP_ENV=development
WP_HOME=https://studio-atlas.ddev.site
WP_SITEURL=${WP_HOME}/wp

# -----------------------------------------------------------------------------
# Clés de sécurité WordPress
# Générer un jeu complet via https://roots.io/salts.html
# -----------------------------------------------------------------------------
AUTH_KEY='generate-me'
SECURE_AUTH_KEY='generate-me'
LOGGED_IN_KEY='generate-me'
NONCE_KEY='generate-me'
AUTH_SALT='generate-me'
SECURE_AUTH_SALT='generate-me'
LOGGED_IN_SALT='generate-me'
NONCE_SALT='generate-me'

# -----------------------------------------------------------------------------
# ACF Pro
# Ce dépôt utilise le plugin gratuit "Advanced Custom Fields" (via WPackagist)
# comme placeholder, car ACF Pro n'est pas distribuable sans licence commerciale.
# Le code (Blocks, Flexible Content) cible volontairement l'API ACF Pro : en
# renseignant une vraie clé ci-dessous ET en ajoutant le repository composer
# officiel (voir README > "Compromis"), le plugin gratuit peut être remplacé
# par ACF Pro sans aucune modification de code.
# -----------------------------------------------------------------------------
ACF_PRO_KEY=your-acf-pro-license-key-here

# -----------------------------------------------------------------------------
# Cache objet (optionnel — voir README > Performance)
# -----------------------------------------------------------------------------
WP_REDIS_HOST=redis
WP_REDIS_PORT=6379
DISABLE_WP_CRON=false
