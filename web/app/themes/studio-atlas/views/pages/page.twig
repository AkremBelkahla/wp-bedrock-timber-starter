{% extends 'pages/base.twig' %}

{% block content %}
    <article class="page">
        {% if blocks %}
            {% for block in blocks %}
                {% include 'blocks/' ~ block.type ~ '.twig' with block.data %}
            {% endfor %}
        {% else %}
            <div class="page__content">
                <h1 class="page__title">{{ post.title }}</h1>
                {{ post.content }}
            </div>
        {% endif %}
    </article>
{% endblock %}
