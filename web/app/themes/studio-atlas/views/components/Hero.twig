<section class="hero">
    {% if background %}
        <img class="hero__background" src="{{ background.src }}" alt="" loading="lazy" width="{{ background.width }}" height="{{ background.height }}">
    {% endif %}
    <div class="hero__content">
        <h1 class="hero__title">{{ title }}</h1>
        {% if subtitle %}<p class="hero__subtitle">{{ subtitle }}</p>{% endif %}
        {% if cta_label and cta_url %}
            <a class="hero__cta" href="{{ cta_url }}">{{ cta_label }}</a>
        {% endif %}
    </div>
</section>
