<?xml version="1.0"?>
<ruleset name="StudioAtlas">
    <description>Standards de code pour Studio Atlas — WPCS appliqué au code custom uniquement.</description>

    <!-- Périmètre : uniquement notre code, jamais le core WP ni les vendors -->
    <file>web/app/themes/studio-atlas/src</file>
    <file>web/app/themes/studio-atlas/functions.php</file>
    <file>web/app/mu-plugins/studio-atlas-loader.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>web/wp/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <arg name="colors"/>

    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress">
        <!-- Le code est organisé en classes namespacées PSR-4, pas de préfixe requis -->
        <exclude name="WordPress.Files.FileName"/>
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
    </rule>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="studio-atlas"/>
        </properties>
    </rule>

    <rule ref="Generic.Arrays.DisallowShortArraySyntax.Found">
        <severity>0</severity>
    </rule>
</ruleset>
